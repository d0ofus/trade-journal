# PostgreSQL application database
DATABASE_URL=""
DIRECT_URL=""

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
AUTH_USERNAME=""
AUTH_PASSWORD=""

# IBKR Flex Web Service
IBKR_FLEX_TOKEN=""
IBKR_FLEX_QUERY_ID=""
IBKR_FLEX_BASE_URL="https://gdcdyn.interactivebrokers.com/Universal/servlet"
IBKR_FLEX_MAX_POLLS="20"
IBKR_FLEX_POLL_MS="3000"
IBKR_FLEX_RUN_SECRET=""

CRON_SECRET=""

# Market data providers
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET_KEY=""
ALPACA_DATA_BASE_URL="https://data.alpaca.markets"
ALPACA_DATA_FEED="iex"
ALPACA_ADJUSTMENT="raw"
MARKET_OVERVIEW_API_BASE=""
MARKET_OVERVIEW_API_TOKEN=""
MARKET_OVERVIEW_WEB_BASE=""
NEXT_PUBLIC_TRADINGVIEW_LIBRARY_PATH=""

# Opt-in workstation charts. These credentials do not configure legacy charts or outcomes.
TRADES_WORKSTATION_ENABLED="0"
TRADES_WORKSTATION_PREVIEW="0"
TRADES_CHART_PROVIDER="legacy"
TRADES_ALPACA_API_KEY_ID=""
TRADES_ALPACA_API_SECRET_KEY=""
TRADES_ALPACA_DATA_FEED="sip"
TRADES_ALPACA_ADJUSTMENT="raw"
TRADES_ALPACA_DELAY_SECONDS="900"
TRADES_CHART_YAHOO_FALLBACK="1"
# Apply the additive compact-cache migration before enabling. Enable preparation only after checking Neon Usage.
TRADES_CANDLE_CACHE_ENABLED="0"
TRADES_CANDLE_PREPARE_ENABLED="0"

# Object storage for screenshots and raw imports
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# Diagnostics
APP_DIAGNOSTICS="0"

# Notion internal connection: server-side only. Share the Trades database,
# registered New page template, and all six related databases with it.
# Keep publishing disabled until the preview/live test-page release gates pass.
NOTION_TOKEN=""
NOTION_PUBLISH_ENABLED="0"

# Optional declared application/contact identity for the public SEC historical-shares API.
SEC_USER_AGENT=""

# Test safety. Use a dedicated PostgreSQL database or schema whose name
# contains test, e2e, or ci. Never enable this against user data.
ALLOW_TEST_DATABASE_MUTATIONS="0"
PLAYWRIGHT_PORT="3100"
PLAYWRIGHT_BASE_URL="http://localhost:3100"
E2E_DEMO_ONLY_WRITES="0"

# Required only to seed demo rows into an explicitly shared database.
ALLOW_SHARED_DEMO_SEED=""
