{
  "name": "trade-journal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:repo-safety",
    "build": "next build",
    "check:repo-history-safety": "node scripts/repository-safety/history-cli.mjs",
    "check:repo-safety": "node scripts/repository-safety/cli.mjs",
    "check:cutover-preflight": "node scripts/repository-safety/cutover-preflight-cli.mjs",
    "start": "next start",
    "lint": "eslint",
    "pretest": "npm run check:repo-safety",
    "test": "vitest run",
    "test:db:preflight": "tsx scripts/assert-test-database.ts",
    "test:e2e": "npm run test:db:preflight -- --playwright && npm run build && npm run prisma:seed:demo && playwright test",
    "test:repo-history-safety": "node --test scripts/repository-safety/history-scanner.test.mjs",
    "test:repo-safety": "node --test scripts/repository-safety/scanner.test.mjs",
    "test:cutover-preflight": "node --test scripts/repository-safety/cutover-preflight.test.mjs",
    "test:watch": "vitest",
    "test:workstation": "tsx --test src/lib/workstation/workstation.test.ts src/lib/workstation/history.test.ts src/lib/workstation/shortcuts.test.ts src/lib/workstation/chart-interaction.test.ts",
    "test:workstation:browser": "playwright test --config playwright.workstation.config.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:seed:demo": "tsx prisma/seed.js --demo",
    "test:workstation:providers": "vitest run --config vitest.workstation.config.ts",
    "test:workstation:persistence": "vitest run src/lib/server/trade-workstation.test.ts src/lib/server/backup-restore.test.ts --maxWorkers=1",
    "test:workstation:auth": "playwright test --config playwright.workstation-auth.config.ts",
    "check:workstation:validation": "tsc -p tsconfig.workstation-validation.json",
    "verify:workstation:alpaca": "tsx scripts/verify-workstation-alpaca.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@prisma/client": "^6.19.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "dockview": "^8.3.1",
    "dockview-react": "^8.3.1",
    "fflate": "^0.8.3",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.575.0",
    "next": "^16.2.9",
    "next-auth": "^4.24.13",
    "prisma": "^6.19.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.js"
  }
}
